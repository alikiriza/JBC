// JBC database schema.
//
// PRISMA v7 RULES followed (master_prompt.md §PRISMA v7):
//   RULE 1  generator uses "prisma-client", NOT "prisma-client-js"
//   RULE 2  output to ../lib/generated/prisma  (inside lib/, never app/)
//   RULE 3  NO url in the datasource block — it lives in prisma.config.ts
//   RULE 5  driven by @prisma/adapter-pg (see lib/db.ts)
//
// This file REPLACES the schema shipped by the JB Better Auth UI block. That
// version was missing the providerId+accountId uniqueness rule and the idToken
// column, and knew nothing about JBC's own tables. The model and field names
// Better Auth needs are unchanged, so its Prisma adapter still works.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Better Auth tables — names and fields required by its Prisma adapter.
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // JBC's own field, not part of Better Auth's schema.
  //
  // Set ONLY by syncAdminFlag() in lib/admin.ts after checking the email against
  // the ADMIN_EMAILS allowlist. `input: false` in lib/auth.ts stops Better Auth
  // accepting it from a request body, so no client can make themselves admin.
  isAdmin Boolean @default(false)

  sessions      Session[]
  accounts      Account[]
  priceRequests PriceRequest[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Better Auth writes these on every new session; useful for access auditing.
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One row per provider account. This is what stops a second Google sign-in
  // from the same account creating a duplicate user.
  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────────────────────────────────────────
// JBC's own data
// ─────────────────────────────────────────────────────────────────────────────

/// A price request from one client.
model PriceRequest {
  id       String @id @default(cuid())
  clientId String
  client   User   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // PLACEHOLDER: the cream size, e.g. "30ml". Real sizes must be confirmed
  // before Phase 3 — see project-description.md → Open Items.
  size String

  quantity Int @default(1)

  // The client's optional note about their skin condition.
  note String?

  // Pending → Priced → Closed.
  status String @default("Pending")

  /// The price. NULL until an admin sets it.
  ///
  /// This is the whole reason prices are never public: the price only ever
  /// reaches the client who owns the request, and only after an admin has set
  /// it. No endpoint exposes it publicly.
  price Decimal? @db.Decimal(12, 2)

  // The admin's reply note.
  adminNote String?

  // PLACEHOLDER: how the client is contacted once priced (WhatsApp number or
  // phone). Written by an admin, never by a client.
  contactMethod String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricedAt DateTime?

  // "My requests, newest first" — the most common query.
  @@index([clientId, createdAt])
  // The admin's work queue: everything still waiting for a price.
  @@index([status, createdAt])
  @@map("price_requests")
}